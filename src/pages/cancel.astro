---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Order cancelled | Steph Pemberton Art" noindex={true}>
  <h1 class="text-2xl font-bold">No payment was taken</h1>
  <p class="mt-2 text-stone-600">Your cart is kept as you left it.</p>
  <a href="/cart" class="mt-4 inline-block rounded bg-stone-900 px-4 py-2 text-sm text-white">Return to your cart</a>
</BaseLayout>
