---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="SLP-art — Original art + made-to-order prints (AU)">
  <h1 class="text-3xl font-bold tracking-tight">Original art + made-to-order prints</h1>
  <p class="mt-2 max-w-xl text-stone-600">
    Small independent Australian art shop. Originals are 1-of-1. Prints are made to order in AUD with AU shipping.
  </p>
  <div class="mt-6 flex gap-3">
    <a href="/shop" class="rounded bg-stone-900 px-4 py-2 text-sm text-white">Browse shop</a>
    <a href="/about" class="rounded border border-stone-300 px-4 py-2 text-sm">About the artist</a>
  </div>
  <p class="mt-8 text-sm text-stone-500">Phase 0 scaffold — catalogue lands in Phase 1.</p>
</BaseLayout>
