---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatAUD, toCents } from '../../lib/money';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.data.id } }));
}

const { slug } = Astro.params;
const products = await getCollection('products');
const match = products.find((p) => p.data.id === slug);
if (!match) return Astro.redirect('/shop');
const data = match.data;
const sold = data.status === 'sold';
---
<BaseLayout title={`${data.title} | Steph Pemberton Art`}>
  <a href="/shop" class="text-sm text-stone-500 hover:underline">← Back to shop</a>
  <div class="mt-4 grid gap-8 md:grid-cols-2">
    <img src={data.image} alt={data.title} class="w-full rounded border border-stone-200" />
    <div>
      <p class="text-xs uppercase tracking-wide text-stone-500">
        {data.type === 'original' ? '1-of-1 Original' : 'Made-to-order print'}
      </p>
      <h1 class="mt-1 text-3xl font-bold">{data.title}</h1>
      <p class="mt-2 text-xl">{formatAUD(toCents(data.priceAUD))} AUD</p>

      {sold ? (
        <p class="mt-6 inline-block rounded bg-stone-900 px-4 py-2 text-sm text-white">Sold</p>
      ) : (
        <div class="mt-6">
          {data.variants && (
            <label class="block text-sm">
              <span class="text-stone-600">Size and finish</span>
              <select id="variant" class="mt-1 block w-full rounded border border-stone-300 px-3 py-2">
                {data.variants.map((v) => <option value={v.name}>{v.name}</option>)}
              </select>
            </label>
          )}
          <button
            id="add-btn"
            data-id={data.id}
            class="mt-3 rounded bg-stone-900 px-4 py-2 text-sm text-white"
          >
            Add to cart
          </button>
          <p id="cart-note" class="mt-2 text-sm text-stone-500"></p>
          <p class="mt-3 text-sm text-stone-500">Ships within Australia. Postage is confirmed by email after you order.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { addToCart, cartCount, $cart } from '../../lib/cart';
  const btn = document.querySelector<HTMLButtonElement>('#add-btn');
  const note = document.querySelector('#cart-note');
  const variantSel = document.querySelector<HTMLSelectElement>('#variant');
  const update = () => { if (note) note.textContent = `In your cart: ${cartCount($cart.get())} item(s).`; };
  $cart.subscribe(update); update();
  btn?.addEventListener('click', () => {
    addToCart(btn.dataset.id!, 1, variantSel?.value);
    update();
  });
</script>
