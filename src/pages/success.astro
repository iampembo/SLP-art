---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank you | Steph Pemberton Art" noindex={true}>
  <h1 class="text-2xl font-bold">Thank you, your order is confirmed</h1>
  <p class="mt-2 text-stone-600">A receipt from Stripe is on its way to your inbox, with delivery updates to follow.</p>
  <a href="/shop" class="mt-4 inline-block rounded border border-stone-300 px-4 py-2 text-sm">Keep browsing</a>
</BaseLayout>

<script>
  import { clearCart } from '../lib/cart';
  clearCart();
</script>
